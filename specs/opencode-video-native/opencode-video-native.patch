diff --git a/packages/core/test/attachment-video.test.ts b/packages/core/test/attachment-video.test.ts
new file mode 100644
index 0000000..7ba52e7
--- /dev/null
+++ b/packages/core/test/attachment-video.test.ts
@@ -0,0 +1,86 @@
+import { describe, expect, test } from "bun:test"
+import { Message } from "@opencode/ai/effect"
+import { Model } from "@opencode/core/model"
+import { Mime } from "@opencode/core/mime"
+import { Provider } from "@opencode/core/provider"
+import { unsupportedParts } from "@opencode/core/session/model-request"
+import { SessionMessage } from "@opencode/core/session/message"
+import { toLLMMessages } from "@opencode/core/session/runner/to-llm-message"
+import { Base64, FileAttachment } from "@opencode/schema/prompt"
+import { DateTime } from "effect"
+import { pathToFileURL } from "url"
+
+const header = (hex: string) => Uint8Array.from(Buffer.from(hex, "hex"))
+const created = DateTime.makeUnsafe(0)
+const model = Model.Ref.make({ id: Model.ID.make("model"), providerID: Provider.ID.make("opencode-go") })
+const capabilities = (input: string[]) => ({ tools: true, input, output: ["text"] })
+
+const MP4 = "000000206674797069736f6d0000020069736f6d69736f32617663316d703431"
+const QUICKTIME = "00000014667479707174202000000200717420200000000877696465"
+const WEBM = "52494646240000005745424d5638504d0000000000000000"
+const WEBP = "524946461a000000574542505650384c0000000000000000"
+
+const userId = SessionMessage.ID.make("msg_video")
+const clip = (source: FileAttachment["source"]) =>
+  FileAttachment.make({
+    data: Base64.make(Buffer.from(MP4, "hex").toString("base64")),
+    mime: "video/mp4",
+    source,
+    name: "clip.mp4",
+  })
+const userMessage = (files: FileAttachment[]) =>
+  SessionMessage.User.make({
+    id: userId,
+    type: "user",
+    text: "Watch this",
+    files,
+    time: { created },
+  })
+
+describe("Mime.detect video containers", () => {
+  test("detects MP4, QuickTime and WebM from their bytes", () => {
+    expect(Mime.detect(header(MP4))).toBe("video/mp4")
+    expect(Mime.detect(header(QUICKTIME))).toBe("video/quicktime")
+    expect(Mime.detect(header(WEBM))).toBe("video/webm")
+  })
+
+  test("leaves the RIFF/WebP container to image/webp", () => {
+    expect(Mime.detect(header(WEBP))).toBe("image/webp")
+  })
+})
+
+describe("video attachments reach the model request", () => {
+  test("a video attachment becomes an inline video media part, with the file location", () => {
+    const uri = pathToFileURL("/project/clip.mp4").href
+    const [message] = toLLMMessages([userMessage([clip({ type: "uri", uri })])], model)
+    const content = message?.content ?? []
+    const media = content.flatMap((part) => (part.type === "media" ? [part] : []))
+
+    expect(message?.role).toBe("user")
+    expect(content).toContainEqual(Message.text("Attached file: /project/clip.mp4"))
+    expect(media.length).toBe(1)
+    expect(media[0]?.media.kind).toBe("video")
+    expect(media[0]?.media.mediaType).toBe("video/mp4")
+    expect(media[0]?.filename).toBe("clip.mp4")
+  })
+
+  test("a model without video input gets the short note in place of the part", () => {
+    const [message] = toLLMMessages([userMessage([clip({ type: "inline" })])], model)
+    const [replaced] = unsupportedParts([message!], capabilities(["text", "image"]), "opencode-go")
+    const text = replaced?.content.flatMap((part) => (part.type === "text" ? [part.text] : []))
+
+    expect(text).toEqual([
+      "Watch this",
+      'ERROR: Cannot read "clip.mp4" (this model does not support video input). Inform the user.',
+    ])
+  })
+
+  test("a model with video input keeps the part", () => {
+    const [message] = toLLMMessages([userMessage([clip({ type: "inline" })])], model)
+    const [kept] = unsupportedParts([message!], capabilities(["text", "video"]), "opencode-go")
+    const media = (kept?.content ?? []).flatMap((part) => (part.type === "media" ? [part] : []))
+
+    expect(media.length).toBe(1)
+    expect(media[0]?.media.kind).toBe("video")
+  })
+})
