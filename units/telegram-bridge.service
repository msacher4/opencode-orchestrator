[Unit]
Description=Telegram → OpenCode Bridge
Documentation=https://opencode.ai/docs/server
After=network-online.target opencode-serve-v2.service
Wants=network-online.target opencode-serve-v2.service

[Service]
Type=simple
User=marcs
Group=marcs
EnvironmentFile=/home/marcs/.telegram-bridge-venv/bridge.env
ExecStart=/home/marcs/.telegram-bridge-venv/bin/python3 /home/marcs/.telegram-bridge-venv/bridge.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target